@startuml
!theme plain
skinparam shadowing false

autonumber
actor Shawn
participant "WorkoutScreen" as UI
participant "CameraX" as Camera
participant "LatestFrameScheduler" as Scheduler
participant "MediaPipe Pose" as Pose
participant "CoordinateNormalizer" as Normalize
participant "SignalProcessor" as Signal
participant "TrackingQualityGate" as Gate
participant "InclineDbPressAnalyzer" as Analyzer
participant "BiomechanicsMetrics" as Metrics
participant "RuleEngine" as Rules
participant "CueArbitrator" as Cue
queue "TelemetryRingBuffer" as TelemetryQ
queue "PriorityPersistenceQueue" as PriorityQ
participant "BatchWriter" as Writer
participant "WorkoutRepository" as Repo
database "Room / SQLite" as DB

Shawn -> UI : select Incline Dumbbell Press
Shawn -> UI : Start Set
UI -> Repo : create ExerciseSet\ntelemetryExpiresAt = startedAt + 7 days
Repo -> DB : persist set state
UI -> Camera : start stream

loop each camera frame
  Camera -> Scheduler : frame + monotonic timestamp
  Scheduler -> Pose : newest eligible frame
  Pose --> Normalize : landmarks + confidence
  Normalize --> Signal : canonical coordinates
  Signal --> Gate : MovementFrame
  alt tracking invalid
    Gate --> UI : setup / visibility guidance
  else valid
    Gate --> Analyzer : valid frame
    Analyzer -> Analyzer : update rep state
    Analyzer -> Metrics : calculate metrics
    Analyzer -> Rules : evaluate metrics / phase / history
    Rules --> Cue : set-scoped FormEvent + FormEvidence[]\noptional repId
    Rules -> PriorityQ : FormEvent + structured evidence

    alt CueArbitrator selects feedback
      Cue --> UI : one prioritized visual cue
      opt offline TTS voice available
        Cue --> UI : speak same short cue via local TTS
      end
      Cue -> PriorityQ : CueDelivery
    else issue suppressed by priority/cooldown
      Cue --> Cue : no delivery record
    end

    Analyzer -> TelemetryQ : raw telemetry
    alt rep completed
      Analyzer --> UI : increment rep count
      Analyzer -> PriorityQ : rep summary + CompactRepTrace
      Metrics -> PriorityQ : final rep metrics
    end
  end
end

loop async priority persistence
  PriorityQ -> Writer : next priority batch
  Writer -> Repo : persist
  Repo -> DB : transaction
end
loop async telemetry persistence
  TelemetryQ -> Writer : next telemetry batch
  Writer -> Repo : persist short-lived telemetry
  Repo -> DB : transaction
end

Shawn -> UI : Stop Set
UI -> Camera : stop stream
UI -> PriorityQ : finalize set summary\nendedAt + telemetryExpiresAt = endedAt + 7 days

note over TelemetryQ,PriorityQ
Storage is outside the coaching critical path.
PriorityPersistenceQueue is in-memory priority scheduling,
not durable storage; records become durable after Room commit.
end note

note over Rules,Cue
FormEvent belongs to the set and can optionally reference a rep.
Detection/evidence and feedback delivery are separately persisted.
end note

@enduml
