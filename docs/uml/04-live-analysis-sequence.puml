@startuml
!theme plain
skinparam shadowing false

autonumber
actor Shawn
participant "WorkoutScreen" as UI
participant "WorkoutSessionController" as Session
participant "CameraX" as Camera
participant "LatestFrameScheduler" as Scheduler
participant "MediaPipe Pose" as Pose
participant "OrderedResultGate" as Ordered
participant "SerializedAnalysisLane" as Lane
participant "TelemetrySamplerChunker" as TelemetryStage
participant "CoordinateNormalizer" as Normalize
participant "SignalProcessor" as Signal
participant "TrackingQualityGate" as Gate
participant "TemporalResetCoordinator" as Reset
participant "InclineDbPressAnalyzer" as Analyzer
participant "BiomechanicsMetrics" as Metrics
participant "RuleEngine + EpisodeTracker" as Rules
participant "CueArbitrator" as Cue
participant "RepFinalizationAssembler" as RepFinalize
queue "ShortLivedTelemetryBuffer" as TelemetryQ
queue "PriorityPersistenceQueue" as PriorityQ
participant "SerializedBatchWriter" as Writer
participant "WorkoutRepository" as Repo
database "Room / SQLite" as DB

Shawn -> UI : select Incline Dumbbell Press
Shawn -> UI : Start Set
UI -> Session : startSet()
Session -> Repo : create ACTIVE ExerciseSet\ntelemetryExpiresAt = startedAt + 7 days\nstartedAtElapsedNanos = monotonic origin
Repo -> DB : persist set state
Session -> Camera : start accepting frames

loop camera stream
  Camera -> Scheduler : frame + monotonic timestamp
  Scheduler -> Pose : newest eligible frame
  Pose --> Ordered : pose result + source timestamp
  alt timestamp <= lastProcessedTimestamp
    Ordered -> Ordered : discard late/out-of-order result
  else strictly newer
    Ordered -> Lane : enqueue ordered result
    Lane -> TelemetryStage : ordered PoseObservation\nno image bytes
    TelemetryStage -> TelemetryStage : bounded-rate sample + chunk
    opt chunk ready
      TelemetryStage -> TelemetryQ : PoseObservationChunk
    end
    Lane -> Normalize : ordered pose output
    Normalize -> Signal : canonical coordinates
    Signal -> Gate : confidence-aware smoothed MovementFrame

    alt tracking invalid
      Gate --> UI : setup / visibility guidance
      Gate -> TelemetryQ : TrackingEvent on meaningful state transition
      alt invalid gap exceeds tolerated duration
        Gate -> Reset : reset(TRACKING_GAP)
        Reset -> Signal : clear filter / velocity state
        Reset -> Analyzer : invalidate current rep temporal state
        Reset -> Metrics : clear ROM / tempo / trajectory accumulators
        Reset -> Rules : interrupt active temporal episodes
        Reset -> RepFinalize : invalidate current trace builder state
        Rules -> PriorityQ : revisioned FormEvent INTERRUPTED upserts
      end
    else tracking valid
      Gate --> Analyzer : valid frame
      Analyzer -> Analyzer : update exercise-specific rep state
      Analyzer -> Metrics : update metrics
      Metrics -> Rules : metrics + phase + recent history
      Rules -> Rules : update issue episodes\nPENDING / ACTIVE / FINALIZED

      alt issue activates or materially changes/finalizes
        Rules -> PriorityQ : revisioned FormEvent + FormEvidence upsert
      end

      Rules --> Cue : active actionable issue state
      alt CueArbitrator selects feedback
        Cue --> UI : one prioritized visual cue
        opt offline TTS voice available
          Cue --> UI : speak same short cue via local TTS
        end
        Cue -> PriorityQ : CueDelivery
      else suppressed by priority/cooldown
        Cue --> Cue : no CueDelivery
      end

      alt rep completed or partial rep finalized
        Analyzer -> RepFinalize : rep state / completion state
        Metrics -> RepFinalize : final RepMetric[]
        Rules -> RepFinalize : rep-scoped FormEvent finalizations
        RepFinalize -> PriorityQ : RepFinalizationBundle\n(one atomic priority command)
        Analyzer --> UI : increment count only for COMPLETED rep
      end
    end
  end
end

loop async serialized priority persistence
  PriorityQ -> Writer : next commandSequence
  Writer -> Repo : persist/upsert in command order
  Repo -> DB : transaction\nreject stale FormEvent eventRevision
end
loop async short-lived telemetry persistence
  TelemetryQ -> Writer : best-effort telemetry batch when priority lane permits
  Writer -> Repo : persist PoseObservationChunk / TrackingEvent
  Repo -> DB : transaction
end

Shawn -> UI : Stop Set
UI -> Session : stopSet()
Session -> Camera : stop accepting new frames
Session -> Session : await full pipeline quiescence\n(no in-flight inference, ordered result, or analysis work)
Session -> TelemetryStage : flush partial short-lived chunk best-effort
TelemetryStage -> TelemetryQ : optional final PoseObservationChunk
Session -> Analyzer : finalizeSet()
Session -> Metrics : finalizeSet()
Session -> Rules : finalizeSet()
Analyzer -> RepFinalize : partial/aborted rep state if any
Metrics -> RepFinalize : final metrics if any
Rules -> RepFinalize : rep-scoped finalizations if any
RepFinalize -> PriorityQ : final RepFinalizationBundle if applicable
Rules -> PriorityQ : finalize remaining set-scoped FormEvent episodes
Session -> PriorityQ : enqueue SetCloseBarrier\nhighWatermark = last assigned priority commandSequence\nendedAt + status=COMPLETED\ntelemetryExpiresAt = endedAt + 7 days
PriorityQ -> Writer : drain/commit all commands <= highWatermark, then barrier
Writer -> Repo : commit close barrier after required commands durable
Repo -> DB : durable transaction(s)
Writer --> Session : SetCloseBarrier committed
Session --> UI : set saved / closed
UI --> Shawn : saved

note over Ordered,Lane
All stateful biomechanics processing is serialized and timestamp ordered.
Late inference callbacks are discarded rather than mutating old temporal state.
end note

note over Signal,Reset
A significant discontinuity resets every stateful temporal consumer:
filter/velocity history, rep FSM, metric accumulators, trace builder and rule episodes.
Recovery starts from a fresh stable movement state.
end note

note over RepFinalize,PriorityQ
RepFinalizationBundle is the atomic durability unit for a rep.
A saved rep cannot exist without its final metrics/trace bundle transaction.
end note

note over PriorityQ,Writer
Priority commands carry monotonic commandSequence values.
FormEvent writes carry eventRevision values.
SetCloseBarrier is reserved/non-droppable and closes only after all
priority commands <= highWatermark are durable.
end note

note over TelemetryQ,PriorityQ
Short-lived pose/debug telemetry is best-effort and may be dropped under pressure.
Higher-value records are prioritized; persistence never blocks live coaching.
end note

@enduml
