@startuml
!theme plain
skinparam shadowing false
hide methods

class UserProfile {
  heightCm: Double
  preferredUnits: String
  activeTrainingPlanId: String?
  activeTrainingPlanVersion: Int?
}

class TrainingPlan {
  id: String
  name: String
  version: Int
}

class TrainingDay {
  id: String
  dayOfWeek: Int
  displayName: String
  order: Int
}

class PlannedExercise {
  id: String
  exerciseId: String
  order: Int
  notes: String?
}

class PlannedSet {
  id: String
  setNumber: Int
  targetLoadPct: Double?
  loadPercentBasis: String?
  repsMin: Int?
  repsMax: Int?
  rirMin: Int?
  rirMax: Int?
}

class ExerciseDefinition {
  id: String
  displayName: String
  analyzerType: String
  defaultCameraView: String
}

class CalibrationProfile {
  id: UUID
  exerciseId: String
  version: Int
  createdAt: Instant
  cameraView: String
  baselineMetadata: String?
}

class DailyContext {
  date: LocalDate
  caloriesKcal: Int?
  proteinG: Double?
  carbsG: Double?
  fatG: Double?
  preWorkoutCarbsG: Double?
  waterMl: Int?
  sodiumMg: Int?
}

class DailyHealthSummary {
  date: LocalDate
  sleepMinutes: Int?
  sleepQuality: Int?
  restingHeartRateBpm: Double?
  steps: Long?
  activeCaloriesKcal: Double?
  sourceSummary: String?
}

class WeeklyBodyComposition {
  weekStart: LocalDate
  medianWeightKg: Double?
  weightSampleCount: Int
  medianBodyFatPct: Double?
  bodyFatSampleCount: Int
  sourceSummary: String?
}

class WorkoutSession {
  id: UUID
  startedAt: Instant
  endedAt: Instant?
  status: String
  trainingPlanId: String?
  trainingPlanVersion: Int?
  appBuild: String
  poseModelVersion: String
}

class ExerciseExecution {
  id: UUID
  exerciseId: String
  plannedExerciseId: String?
  order: Int
  startedAt: Instant
  endedAt: Instant?
  status: String
  analyzerVersion: Int
  metricVersion: Int
  calibrationProfileId: UUID?
  calibrationVersion: Int?
}

class ExerciseSet {
  id: UUID
  plannedSetId: String?
  setNumber: Int
  loadKg: Double?
  targetReps: Int?
  startedAt: Instant
  endedAt: Instant?
  status: String
  telemetryExpiresAt: Instant
}

class Rep {
  id: UUID
  repNumber: Int
  startedAtElapsedNanos: Long
  endedAtElapsedNanos: Long
  completionState: String
}

class PoseObservation {
  elapsedRealtimeNanos: Long
  imageLandmarks: PoseLandmark[]
  worldLandmarks: PoseLandmark[]?
  rotationDegrees: Int
  mirrored: Boolean
  frameWidth: Int
  frameHeight: Int
}

class TrackingEvent {
  elapsedRealtimeNanos: Long
  type: String
  severity: Severity
  details: String?
}

class RepMetric {
  metricType: MetricType
  value: Double
  unit: String
  confidence: Double
  metricVersion: Int
}

class FormEvent {
  id: UUID
  repId: UUID?
  ruleId: String
  ruleVersion: Int
  severity: Severity
  confidence: Double
  startedAtElapsedNanos: Long
  endedAtElapsedNanos: Long
}

class FormEvidence {
  key: String
  observedValue: Double?
  unit: String?
  comparator: String?
  thresholdValue: Double?
  textValue: String?
}

class CueDelivery {
  id: UUID
  deliveredAtElapsedNanos: Long
  channel: String
  message: String
}

class CompactRepTrace {
  traceVersion: Int
  schemaId: String
  pointCount: Int
  normalizedTime: Float[]
}

class TraceChannel {
  name: String
  unit: String
  side: String?
  values: Float[]
}

UserProfile "1" -- "0..*" TrainingPlan
TrainingPlan "1" *-- "1..*" TrainingDay
TrainingDay "1" *-- "1..*" PlannedExercise
PlannedExercise "1" *-- "1..*" PlannedSet
PlannedExercise "0..*" --> "1" ExerciseDefinition : references >
UserProfile "1" -- "0..*" CalibrationProfile
ExerciseDefinition "1" -- "0..*" CalibrationProfile
UserProfile "1" -- "0..*" DailyContext
UserProfile "1" -- "0..*" DailyHealthSummary
UserProfile "1" -- "0..*" WeeklyBodyComposition
UserProfile "1" -- "0..*" WorkoutSession
WorkoutSession "0..*" --> "0..1" DailyContext : optional nutrition context >
WorkoutSession "0..*" --> "0..1" DailyHealthSummary : optional health context >
WorkoutSession "1" *-- "0..*" ExerciseExecution
ExerciseExecution "0..*" --> "1" ExerciseDefinition : executes >
ExerciseExecution "0..*" --> "0..1" CalibrationProfile : used calibration >
ExerciseExecution "1" *-- "0..*" ExerciseSet
ExerciseSet "1" *-- "0..*" PoseObservation
ExerciseSet "1" *-- "0..*" TrackingEvent
ExerciseSet "1" *-- "0..*" Rep
ExerciseSet "1" *-- "0..*" FormEvent
Rep "0..1" <-- "0..*" FormEvent : optional repId
Rep "1" *-- "0..*" RepMetric
FormEvent "1" *-- "1..*" FormEvidence
FormEvent "1" *-- "0..*" CueDelivery
Rep "1" *-- "0..1" CompactRepTrace
CompactRepTrace "1" *-- "1..*" TraceChannel

note right of PlannedSet
targetLoadPct is not meaningful without a basis.
Store loadPercentBasis when known; leave it null when the
source plan does not define the denominator rather than guessing.
end note

note right of ExerciseExecution
Store both calibrationProfileId and calibrationVersion when used.
A version number alone is not enough provenance if multiple profiles exist.
end note

note right of ExerciseSet
telemetryExpiresAt is NON-NULL from set creation.
Initialize fail-safe expiry at startedAt + 7 days.
On normal set close, update it to endedAt + 7 days.
A crash therefore cannot leave short-lived data with no expiry.
end note

note right of WorkoutSession
WorkoutSession / ExerciseExecution / ExerciseSet use explicit status.
Normal close transitions ACTIVE -> COMPLETED.
Startup recovery transitions stale ACTIVE records -> INTERRUPTED.
end note

note right of PoseObservation
Short-lived perception output only; never image/video bytes.
Captured immediately after MediaPipe and before normalization/smoothing
so recent replay can re-run downstream deterministic processing.
Storage is best-effort and may contain gaps under pressure.
end note

note right of FormEvent
FormEvent belongs to the ExerciseSet and may optionally reference a Rep.
This supports issues detected during setup/top position, partial attempts,
or movement that never becomes a completed/recognized rep.
Evidence and actual cue delivery remain separate children.
end note

note right of CompactRepTrace
Generic long-term compact reinterpretation artifact.
schemaId + TraceChannel[] allow exercise-specific signals.
It does not claim full-fidelity replay after short-lived observations expire.
end note

@enduml
