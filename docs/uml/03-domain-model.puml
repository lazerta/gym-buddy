@startuml
!theme plain
skinparam shadowing false
hide methods

class UserProfile {
  heightCm: Double
  preferredUnits: String
  activeTrainingPlanId: String?
  activeTrainingPlanVersion: Int?
}

class TrainingPlan {
  id: String
  name: String
  version: Int
}

class TrainingDay {
  id: String
  dayOfWeek: Int
  displayName: String
  order: Int
}

class PlannedExercise {
  id: String
  exerciseId: String
  order: Int
  notes: String?
}

class PlannedSet {
  id: String
  setNumber: Int
  targetLoadPctMin: Double?
  targetLoadPctMax: Double?
  loadPercentBasis: String?
  repsMin: Int?
  repsMax: Int?
  rirMin: Int?
  rirMax: Int?
}

class ExerciseDefinition {
  id: String
  displayName: String
  analyzerType: String
  defaultCameraView: String
}

class CalibrationProfile {
  id: UUID
  exerciseId: String
  version: Int
  createdAt: Instant
  cameraView: String
  baselineMetadata: String?
}

class DailyContext {
  date: LocalDate
  caloriesKcal: Int?
  proteinG: Double?
  carbsG: Double?
  fatG: Double?
  preWorkoutCarbsG: Double?
  waterMl: Int?
  sodiumMg: Int?
}

class DailyHealthSummary {
  date: LocalDate
  aggregationVersion: Int
  computedAt: Instant
  sleepMinutes: Int?
  sleepQuality: Int?
  restingHeartRateBpm: Double?
  steps: Long?
  activeCaloriesKcal: Double?
  sourceSummary: String?
}

class WeeklyBodyComposition {
  weekStart: LocalDate
  aggregationVersion: Int
  computedAt: Instant
  medianWeightKg: Double?
  weightSampleCount: Int
  medianBodyFatPct: Double?
  bodyFatSampleCount: Int
  sourceSummary: String?
}

class WorkoutSession {
  id: UUID
  startedAt: Instant
  endedAt: Instant?
  status: String
  trainingPlanId: String?
  trainingPlanVersion: Int?
  appBuild: String
  poseModelVersion: String
}

class ExerciseExecution {
  id: UUID
  exerciseId: String
  plannedExerciseId: String?
  order: Int
  startedAt: Instant
  endedAt: Instant?
  status: String
  pipelineVersion: Int
  analyzerVersion: Int
  metricVersion: Int
  ruleSetVersion: Int
  cuePolicyVersion: Int
  calibrationProfileId: UUID?
  calibrationVersion: Int?
}

class ExerciseParameterSnapshot {
  key: String
  numericValue: Double?
  textValue: String?
  unit: String?
}

class ExerciseSet {
  id: UUID
  plannedSetId: String?
  setNumber: Int
  startedAt: Instant
  startedAtElapsedNanos: Long
  endedAt: Instant?
  status: String
  telemetryExpiresAt: Instant
}

class ResistanceSnapshot {
  value: Double?
  unit: String?
  mode: String
}

class Rep {
  id: UUID
  repNumber: Int
  startedOffsetNanos: Long
  endedOffsetNanos: Long
  completionState: String
}

class PoseObservation <<value object>> {
  observationSchemaVersion: Int
  offsetNanosFromSetStart: Long
  imageLandmarks: PoseLandmark[]
  worldLandmarks: PoseLandmark[]?
  rotationDegrees: Int
  mirrored: Boolean
  frameWidth: Int
  frameHeight: Int
}

class PoseObservationChunk {
  id: UUID
  observationSchemaVersion: Int
  codecVersion: Int
  startOffsetNanos: Long
  endOffsetNanos: Long
  sampleCount: Int
  payload: ByteArray
}

class TrackingEvent {
  offsetNanosFromSetStart: Long
  type: String
  severity: Severity
  details: String?
}

class RepMetric {
  metricType: MetricType
  value: Double
  unit: String
  confidence: Double
  metricVersion: Int
}

class FormEvent {
  id: UUID
  repId: UUID?
  scope: String
  ruleId: String
  ruleVersion: Int
  eventRevision: Long
  status: String
  severity: Severity
  confidence: Double
  startedOffsetNanos: Long
  lastUpdatedOffsetNanos: Long
  endedOffsetNanos: Long?
}

class FormEvidence {
  key: String
  observedValue: Double?
  unit: String?
  comparator: String?
  thresholdValue: Double?
  textValue: String?
}

class CueDelivery {
  id: UUID
  deliveredOffsetNanos: Long
  channel: String
  message: String
}

class CompactRepTrace {
  traceVersion: Int
  schemaId: String
  pointCount: Int
  normalizedTime: Float[]
}

class TraceChannel {
  name: String
  unit: String
  side: String?
  values: Float[]
}

class RepFinalizationBundle <<command>> {
  commandSequence: Long
  repId: UUID
  completionState: String
}

UserProfile "1" -- "0..*" TrainingPlan
TrainingPlan "1" *-- "1..*" TrainingDay
TrainingDay "1" *-- "1..*" PlannedExercise
PlannedExercise "1" *-- "1..*" PlannedSet
PlannedExercise "0..*" --> "1" ExerciseDefinition : references >
UserProfile "1" -- "0..*" CalibrationProfile
ExerciseDefinition "1" -- "0..*" CalibrationProfile
UserProfile "1" -- "0..*" DailyContext
UserProfile "1" -- "0..*" DailyHealthSummary
UserProfile "1" -- "0..*" WeeklyBodyComposition
UserProfile "1" -- "0..*" WorkoutSession
WorkoutSession "0..*" --> "0..1" DailyContext : optional nutrition context >
WorkoutSession "0..*" --> "0..1" DailyHealthSummary : optional health context >
WorkoutSession "1" *-- "0..*" ExerciseExecution
ExerciseExecution "0..*" --> "1" ExerciseDefinition : executes >
ExerciseExecution "0..*" --> "0..1" CalibrationProfile : used calibration >
ExerciseExecution "1" *-- "0..*" ExerciseParameterSnapshot
ExerciseExecution "1" *-- "0..*" ExerciseSet
ExerciseSet "1" *-- "0..1" ResistanceSnapshot
ExerciseSet "1" *-- "0..*" PoseObservationChunk
PoseObservationChunk ..> PoseObservation : decodes to >
ExerciseSet "1" *-- "0..*" TrackingEvent
ExerciseSet "1" *-- "0..*" Rep
ExerciseSet "1" *-- "0..*" FormEvent
Rep "0..1" <-- "0..*" FormEvent : optional repId
Rep "1" *-- "0..*" RepMetric
FormEvent "1" *-- "1..*" FormEvidence
FormEvent "1" *-- "0..*" CueDelivery
Rep "1" *-- "0..1" CompactRepTrace
CompactRepTrace "1" *-- "1..*" TraceChannel
RepFinalizationBundle ..> Rep
RepFinalizationBundle ..> RepMetric
RepFinalizationBundle ..> CompactRepTrace
RepFinalizationBundle ..> FormEvent

note right of TrainingPlan
A published plan version is immutable once referenced by a workout.
Editing the plan creates a new version rather than mutating history.
end note

note right of PlannedSet
Load percentages may be ranges (for example 85-90%).
loadPercentBasis remains null when the source does not define the denominator.
Never infer an undefined basis.
end note

note right of CalibrationProfile
Calibration profiles are immutable/versioned once used.
ExerciseExecution snapshots profile id + version.
end note

note right of ExerciseExecution
pipelineVersion covers shared normalization/smoothing/quality-gate semantics.
Exercise-specific analyzer, metric, rule-set and cue-policy versions are snapshotted.
ExerciseParameterSnapshot captures configuration such as benchAngleDeg.
end note

note right of ExerciseSet
startedAt provides wall-clock history; startedAtElapsedNanos is the runtime
monotonic origin used to convert durable event times to offsets.
telemetryExpiresAt is NON-NULL from set creation: startedAt + 7 days,
then updated to endedAt + 7 days on normal close.
end note

note right of ResistanceSnapshot
Resistance semantics are explicit rather than a bare load number.
Typical modes: PER_HAND, TOTAL_EXTERNAL, MACHINE_STACK, ASSISTANCE, BODYWEIGHT.
Canonical unit conversion is a spec concern; original semantics are preserved.
end note

note right of PoseObservationChunk
Do not persist one Room row per analyzed frame.
Sample ordered pose observations at a bounded persistence rate,
encode multiple observations into versioned chunks, and expire them with the set.
No camera image bytes are stored in PoseObservation.
end note

note right of FormEvent
One continuous detected issue is one stateful episode, not one row/frame.
scope=REP requires repId and finalizes at the rep boundary.
scope=SET may span reps and normally has repId null.
eventRevision increases monotonically so stale upserts cannot overwrite newer state.
CueDelivery remains a separate child and may be absent.
end note

note right of CompactRepTrace
Generic long-term compact reinterpretation artifact.
schemaId + TraceChannel[] allow exercise-specific signals.
It does not claim full-fidelity replay after short-lived observations expire.
end note

note right of RepFinalizationBundle
Rep + RepMetric[] + optional CompactRepTrace + rep-scoped FormEvent finalizations
are one priority command and must commit atomically in one Room transaction.
end note

@enduml
