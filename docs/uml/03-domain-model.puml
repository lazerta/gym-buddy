@startuml
!theme plain
skinparam shadowing false
hide methods

class UserProfile {
  heightCm: Double
  preferredUnits: String
  activeTrainingPlanId: String?
  activeTrainingPlanVersion: Int?
}

class TrainingPlan {
  id: String
  name: String
  version: Int
}

class TrainingDay {
  id: String
  dayOfWeek: Int
  displayName: String
  order: Int
}

class PlannedExercise {
  id: String
  exerciseId: String
  order: Int
  notes: String?
}

class PlannedSet {
  id: String
  setNumber: Int
  targetLoadPct: Double?
  loadPercentBasis: String?
  repsMin: Int?
  repsMax: Int?
  rirMin: Int?
  rirMax: Int?
}

class ExerciseDefinition {
  id: String
  displayName: String
  analyzerType: String
  defaultCameraView: String
}

class CalibrationProfile {
  id: UUID
  exerciseId: String
  version: Int
  createdAt: Instant
  cameraView: String
  baselineMetadata: String?
}

class DailyContext {
  date: LocalDate
  caloriesKcal: Int?
  proteinG: Double?
  carbsG: Double?
  fatG: Double?
  preWorkoutCarbsG: Double?
  waterMl: Int?
  sodiumMg: Int?
}

class DailyHealthSummary {
  date: LocalDate
  sleepMinutes: Int?
  sleepQuality: Int?
  restingHeartRateBpm: Double?
  steps: Long?
  activeCaloriesKcal: Double?
  sourceSummary: String?
}

class WeeklyBodyComposition {
  weekStart: LocalDate
  medianWeightKg: Double?
  weightSampleCount: Int
  medianBodyFatPct: Double?
  bodyFatSampleCount: Int
  sourceSummary: String?
}

class WorkoutSession {
  id: UUID
  startedAt: Instant
  endedAt: Instant?
  trainingPlanId: String?
  trainingPlanVersion: Int?
  appBuild: String
  poseModelVersion: String
}

class ExerciseExecution {
  id: UUID
  exerciseId: String
  plannedExerciseId: String?
  order: Int
  startedAt: Instant
  endedAt: Instant?
  analyzerVersion: Int
  metricVersion: Int
  calibrationVersion: Int?
}

class ExerciseSet {
  id: UUID
  plannedSetId: String?
  setNumber: Int
  loadKg: Double?
  targetReps: Int?
  startedAt: Instant
  endedAt: Instant?
  telemetryExpiresAt: Instant?
}

class Rep {
  id: UUID
  repNumber: Int
  startedAtElapsedNanos: Long
  endedAtElapsedNanos: Long
  completionState: String
}

class TelemetrySample {
  elapsedRealtimeNanos: Long
  repId: UUID?
  phase: String?
  landmarks: PoseLandmark[]
  trackingConfidence: Double
}

class TrackingEvent {
  elapsedRealtimeNanos: Long
  type: String
  severity: Severity
  details: String?
}

class RepMetric {
  metricType: MetricType
  value: Double
  unit: String
  confidence: Double
  metricVersion: Int
}

class FormEvent {
  id: UUID
  ruleId: String
  ruleVersion: Int
  severity: Severity
  confidence: Double
  startedAtElapsedNanos: Long
  endedAtElapsedNanos: Long
}

class FormEvidence {
  key: String
  observedValue: Double?
  unit: String?
  comparator: String?
  thresholdValue: Double?
  textValue: String?
}

class CueDelivery {
  id: UUID
  deliveredAtElapsedNanos: Long
  channel: String
  message: String
}

class CompactRepTrace {
  traceVersion: Int
  schemaId: String
  pointCount: Int
  normalizedTime: Float[]
}

class TraceChannel {
  name: String
  unit: String
  side: String?
  values: Float[]
}

UserProfile "1" -- "0..*" TrainingPlan
TrainingPlan "1" *-- "1..*" TrainingDay
TrainingDay "1" *-- "1..*" PlannedExercise
PlannedExercise "1" *-- "1..*" PlannedSet
PlannedExercise "0..*" --> "1" ExerciseDefinition : references >
UserProfile "1" -- "0..*" CalibrationProfile
ExerciseDefinition "1" -- "0..*" CalibrationProfile
UserProfile "1" -- "0..*" DailyContext
UserProfile "1" -- "0..*" DailyHealthSummary
UserProfile "1" -- "0..*" WeeklyBodyComposition
UserProfile "1" -- "0..*" WorkoutSession
WorkoutSession "0..*" --> "0..1" DailyContext : optional nutrition context >
WorkoutSession "0..*" --> "0..1" DailyHealthSummary : optional health context >
WorkoutSession "1" *-- "0..*" ExerciseExecution
ExerciseExecution "0..*" --> "1" ExerciseDefinition : executes >
ExerciseExecution "1" *-- "0..*" ExerciseSet
ExerciseSet "1" *-- "0..*" TelemetrySample
ExerciseSet "1" *-- "0..*" TrackingEvent
ExerciseSet "1" *-- "0..*" Rep
Rep "0..1" <-- "0..*" TelemetrySample : optional repId
Rep "1" *-- "0..*" RepMetric
Rep "1" *-- "0..*" FormEvent
FormEvent "1" *-- "1..*" FormEvidence
FormEvent "1" *-- "0..*" CueDelivery
Rep "1" *-- "0..1" CompactRepTrace
CompactRepTrace "1" *-- "1..*" TraceChannel

note right of TrainingPlan
Keep plan versions as immutable definitions.
UserProfile points to the active plan/version.
WorkoutSession snapshots the plan id/version used that day.
end note

note right of PlannedSet
targetLoadPct is not meaningful without a basis.
Store loadPercentBasis when known; leave it null when the
source plan does not define the denominator rather than guessing.
Supports per-set rep and RIR targets.
end note

note right of ExerciseSet
Use wall-clock startedAt/endedAt for history and retention.
Set telemetryExpiresAt when the set closes (normally end + 7 days).
RetentionWorker deletes short-lived children using this anchor.
end note

note right of TelemetrySample
Realtime durations use monotonic elapsed-time timestamps,
not wall-clock time. Retain high-frequency samples for 7 days only.
Telemetry belongs to the set and may optionally reference a Rep.
end note

note right of CompactRepTrace
Generic long-term compact replay artifact.
schemaId + TraceChannel[] allow exercise-specific signals.
Use a fixed small number of normalized points per rep.
Full-fidelity re-analysis is limited to the 7-day telemetry window.
end note

note right of FormEvent
FormEvent means a persisted detected issue, not necessarily a spoken cue.
Evidence is structured as FormEvidence[] instead of opaque JSON.
end note

note right of CueDelivery
Persist only cues actually delivered to the user.
A FormEvent may be suppressed by CueArbitrator and have zero deliveries.
channel distinguishes VISUAL / TTS if needed.
end note

note right of DailyHealthSummary
Aggregate Health Connect records locally.
Do not persist fine-grained HR/step/source records long-term.
Missing health data never blocks workout tracking.
end note

@enduml
